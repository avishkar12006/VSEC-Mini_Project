# Copy this file to .env and fill it in.

PORT=5050

# MongoDB. Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:           mongodb+srv://<user>:<password>@<cluster>/portfolio
# Leave empty to run in read-only file mode (site works, contact form saves to a file, admin is off).
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Secret for /admin. Use a long random string. Admin stays disabled if this is empty.
ADMIN_TOKEN=

# Only needed if the React app is served from a different origin than this API.
# CLIENT_ORIGIN=http://localhost:5173
